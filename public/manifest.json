// CHROME & FIREFOX MERGED MANIFEST V3 FILE
// ==========================================================
// THIS FILE CANNOT DIRECTLY USED AND NEED TO BE PARSED FIRST
// ANY LINE COMMENTS IN THIS FILE WILL BE DROPPED DURING BUILD
{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "Discord Web Auto Quest (Reimagined)",
  "version": "1.3.0",
  // Do not remove this field below, Firefox will ignore this even not supported
  "version_name": "1.3.0 Reimagined",
  "description": "A reimagined Discord web auto quest extension.",
  "homepage_url": "https://github.com/mitsuki31/Discord-Web-Auto-Quest-Extension",
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.discord.com/*"
  ],
  "background": {
    // Since Firefox does not support 'service_worker' field,
    // here the service worker should be inside 'scripts' list.
    //
    // One of these fields will be removed based on manifest type
    // during build
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://canary.discord.com/*"],
      "js": ["quest-home.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://discord.com/*", "https://canary.discord.com/*"],
      "js": ["user-agent-override.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
