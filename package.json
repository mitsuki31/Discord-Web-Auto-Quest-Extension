{
  "name": "discord-web-auto-quest-reimagined",
  "version": "1.3.0",
  "description": "A reimagined Discord web auto quest extension.",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "build:watch": "npm run typecheck && tsx --watch scripts/build.ts",
    "build:prod": "npm run build -- --production",
    "package": "tsx scripts/create-zip.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsuki31/Discord-Web-Auto-Quest-Extension.git"
  },
  "author": "Nick Aidil (https://github.com/nvckai)",
  "contributors": [
    "Kiyomi F. (https://github.com/idMJA)",
    "Ryuu Mitsuki (https://github.com/mitsuki31)"
  ],
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/mitsuki31/Discord-Web-Auto-Quest-Extension"
  },
  "homepage": "https://github.com/mitsuki31/Discord-Web-Auto-Quest-Extension#readme",
  "keywords": [],
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^26.4.1",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yazl": "^3.3.1"
  }
}
